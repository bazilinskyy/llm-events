{
  "data": "_output/Output.csv",
  "output_dir": "_output",
  "logger_level": "INFO",
  "auto_open_html": true,
  "filter_rows_with_na": true,
  "na_filter_fields": ["v2_id", "v1_av", "move_v1", "collision_type", "av_guilty", "main_factor"],
  "include_plot_fields": ["v2_id", "v1_av", "move_v1", "collision_type", "av_guilty", "main_factor"],
  "exclude_plot_fields": [],
  "histogram_fields": ["av_make", "collision_type", "main_factor"],
  "max_categories": 20,
  "min_count": 1,
  "row_keep_policy": "output_only"
}